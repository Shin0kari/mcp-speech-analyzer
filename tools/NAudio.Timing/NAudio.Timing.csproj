<Project Sdk="Microsoft.NET.Sdk">
  <!-- Отдельная диагностическая сборка точного source pin. Обычный проект использует NuGet3.3.0. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>NAudio.Wasapi</AssemblyName><Version>3.3.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks><Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <PinRoot>$(MSBuildThisFileDirectory)../../artifacts/capture-measurement-20261103/upstream/NAudio-4f8889e2bd34c3978a25652c6c172fa1502ccba3</PinRoot>
    <PatchRoot>$(MSBuildThisFileDirectory)../../artifacts/capture-measurement-20261103/patched</PatchRoot>
    <SignAssembly>true</SignAssembly><AssemblyOriginatorKeyFile>$(PinRoot)/NAudioStrongNameKey.snk</AssemblyOriginatorKeyFile>
    <!-- Локальная диагностика ссылается на unsigned Core; published NuGet не создаётся. -->
    <NoWarn>$(NoWarn);CS8002</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <KnownFrameworkReference Update="@(KnownFrameworkReference)"><TargetingPackVersion Condition="'%(TargetFramework)' == 'net9.0'">9.0.18</TargetingPackVersion></KnownFrameworkReference>
    <PackageReference Include="NAudio.Core" Version="3.3.0" />
    <ProjectReference Include="../../src/SpeechAnalyzer.Core/SpeechAnalyzer.Core.csproj" />
    <Compile Include="$(PinRoot)/src/NAudio.Wasapi/**/*.cs" Exclude="$(PinRoot)/src/NAudio.Wasapi/obj/**;$(PinRoot)/src/NAudio.Wasapi/WasapiRecorder.cs;$(PinRoot)/src/NAudio.Wasapi/CoreAudioApi/AudioCaptureClient.cs" />
    <Compile Include="$(PatchRoot)/*.cs" />
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute"><_Parameter1>windows</_Parameter1></AssemblyAttribute>
  </ItemGroup>
  <ItemGroup><AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute"><_Parameter1>NAudio.Windows.Tests, </_Parameter1></AssemblyAttribute></ItemGroup>
  <Target Name="CheckPinnedSources" BeforeTargets="BeforeBuild"><Error Condition="!Exists('$(PatchRoot)/WasapiRecorder.cs')" Text="Сначала выполните scripts/prepare-naudio-timing.ps1 с локальным архивом точного pin." /></Target>
</Project>
