<Application x:Class="SpeechAnalyzer.WinUI.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
  <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/>
 </ResourceDictionary.MergedDictionaries>
 <ResourceDictionary.ThemeDictionaries>
  <ResourceDictionary x:Key="Light">
   <SolidColorBrush x:Key="SelectionNoticeBackground" Color="#FFF8E4"/>
   <SolidColorBrush x:Key="SelectionNoticeForeground" Color="#855600"/>
  </ResourceDictionary>
  <ResourceDictionary x:Key="Default">
   <SolidColorBrush x:Key="SelectionNoticeBackground" Color="#38362C"/>
   <SolidColorBrush x:Key="SelectionNoticeForeground" Color="#FFD380"/>
  </ResourceDictionary>
  <ResourceDictionary x:Key="HighContrast">
   <SolidColorBrush x:Key="SelectionNoticeBackground" Color="{ThemeResource SystemColorWindowColor}"/>
   <SolidColorBrush x:Key="SelectionNoticeForeground" Color="{ThemeResource SystemColorWindowTextColor}"/>
  </ResourceDictionary>
 </ResourceDictionary.ThemeDictionaries>
 </ResourceDictionary></Application.Resources>
</Application>
